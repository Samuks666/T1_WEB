<section class="cabecalho-pagina">
  <p class="eyebrow"><i class="fa-solid fa-lock"></i> Administração</p>
  <h1>Agenda do Pet Shop</h1>
  <p>Controle dos pets que irão tomar banho essa semana.</p>
</section>

<section class="cartao tabela-container">
  <table>
    <thead>
      <tr>
        <th>Data</th>
        <th>Horário</th>
        <th>Cliente (Tutor)</th>
        <th>CPF</th>
      </tr>
    </thead>
    <tbody>
      {{#each agendamentos}}
        <tr>
          <td>{{this.data}}</td>
          <td><strong>{{this.horario}}</strong></td>
          <td>{{this.nome}}</td>
          <td>{{this.cpf}}</td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4" class="vazio"><i class="fa-solid fa-paw"></i> Nenhum pet agendado por enquanto.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>