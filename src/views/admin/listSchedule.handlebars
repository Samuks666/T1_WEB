<section class="cabecalho-pagina">
  <p class="eyebrow">Administração</p>
  <h1>Agenda do Pet Shop</h1>
  <p>Agendamentos registrados pelos clientes.</p>
</section>

<section class="cartao tabela-container">
  <table>
    <thead>
      <tr>
        <th>Data</th>
        <th>Horário</th>
        <th>Cliente</th>
        <th>CPF</th>
      </tr>
    </thead>
    <tbody>
      {{#each agendamentos}}
        <tr>
          <td>{{this.data}}</td>
          <td>{{this.horario}}</td>
          <td>{{this.nome}}</td>
          <td>{{this.cpf}}</td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4" class="vazio">Nenhum agendamento realizado.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
