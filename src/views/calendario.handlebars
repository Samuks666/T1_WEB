<section class="cabecalho-pagina">
  <p class="eyebrow">Banho e tosa</p>
  <h1>Agendamento semanal</h1>
  <p>Escolha um dos horários disponíveis e informe seu nome e CPF para confirmar.</p>
</section>

{{#if sucesso}}
  <div class="alerta sucesso">Agendamento realizado com sucesso.</div>
{{/if}}

{{#if erro}}
  <div class="alerta erro">{{erro}}</div>
{{/if}}

<form action="/agendar" method="POST" class="grid-agendamento">
  <section class="cartao">
    <h2>Horários disponíveis</h2>

    {{#each dias}}
      <div class="dia">
        <h3>{{this.rotulo}}</h3>
        <div class="slots">
          {{#each this.horarios}}
            <label class="slot">
              <input
                type="radio"
                name="slot"
                value="{{this.data}}|{{this.horario}}"
                required
              >
              <span>
                <strong>{{this.horario}}</strong>
                <small>{{this.vagas}} vaga(s)</small>
              </span>
            </label>
          {{/each}}
        </div>
      </div>
    {{else}}
      <p class="vazio">Não há horários disponíveis nos próximos sete dias.</p>
    {{/each}}
  </section>

  <section class="cartao dados-cliente">
    <h2>Dados do cliente</h2>

    <label>
      Nome
      <input type="text" name="nome" required autocomplete="name">
    </label>

    <label>
      CPF
      <input type="text" name="cpf" required placeholder="000.000.000-00" inputmode="numeric">
    </label>

    <button type="submit">Confirmar agendamento</button>
  </section>
</form>
