<section class="cabecalho-pagina">
  <p class="eyebrow"><i class="fa-solid fa-bath"></i> Banho e tosa</p>
  <h1>Agendamento da Semana</h1>
  <p>Escolha um horário para o seu pet! <i class="fa-solid fa-dog"></i></p>
</section>

{{#if sucesso}}
  <div class="alerta sucesso"><i class="fa-solid fa-circle-check"></i> Agendamento realizado com sucesso.</div>
{{/if}}

{{#if erro}}
  <div class="alerta erro"><i class="fa-solid fa-triangle-exclamation"></i> {{erro}}</div>
{{/if}}

<form action="/agendar" method="POST" class="grid-agendamento">
  <section class="cartao">
    <h2><i class="fa-regular fa-calendar-check"></i> Horários disponíveis</h2>

    {{#each dias}}
      <div class="dia">
        <h3>{{this.rotulo}}</h3>
        <div class="slots">
          {{#each this.horarios}}
            <label class="slot">
              <input
                type="radio"
                name="slot"
                value="{{this.data}}|{{this.horario}}"
                required
              >
              <span>
                <strong>{{this.horario}}</strong>
                <small>{{this.vagas}} vaga(s)</small>
              </span>
            </label>
          {{/each}}
        </div>
      </div>
    {{else}}
      <p class="vazio"><i class="fa-solid fa-cat"></i> Não há horários disponíveis nos próximos sete dias.</p>
    {{/each}}
  </section>

  <section class="cartao dados-cliente">
    <h2><i class="fa-solid fa-user"></i> Dados do tutor</h2>

    <label>
      Nome
      <input type="text" name="nome" required autocomplete="name" placeholder="Como você se chama?">
    </label>

    <label>
      CPF
      <input type="text" name="cpf" required placeholder="000.000.000-00" inputmode="numeric">
    </label>

    <button type="submit"><i class="fa-solid fa-paw"></i> Confirmar Agendamento</button>
  </section>
</form>