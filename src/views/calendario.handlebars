                <td><input type="number" name="capacidade[Terça][15:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quarta][15:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quinta][15:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sexta][15:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sábado][15:00]" value="2" min="0"></td>
            </tr>

            <tr>
                <td>16:00</td>
                <td><input type="number" name="capacidade[Segunda][16:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Terça][16:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quarta][16:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quinta][16:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sexta][16:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sábado][16:00]" value="2" min="0"></td>
            </tr>

            <tr>
                <td>17:00</td>
                <td><input type="number" name="capacidade[Segunda][17:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Terça][17:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quarta][17:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Quinta][17:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sexta][17:00]" value="2" min="0"></td>
                <td><input type="number" name="capacidade[Sábado][17:00]" value="2" min="0"></td>
            </tr>
            <!-- Você (ou o seu colega usando each do Handlebars) repetirá 
                 essas linhas <tr> para os demais horários do Pet Shop -->

        </tbody>
    </table>

    <!-- O botão tipo 'submit' é o que dispara o envio do <form> inteiro -->
    <button type="submit" class="btn-salvar">Salvar Configurações</button>

</form>